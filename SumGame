#include <string>

class Solution {
public:
    bool sumGame(std::string num) {
        int n = num.length();
        int left_sum = 0, right_sum = 0;
        int left_q = 0, right_q = 0;
        
        // Analyze the first half
        for (int i = 0; i < n / 2; ++i) {
            char ch = num[i];
            if (ch == '?') {
                left_q++;
            } else {
                left_sum += (ch - '0');
            }
        }
        
        // Analyze the second half
        for (int i = n / 2; i < n; ++i) {
            char ch = num[i];
            if (ch == '?') {
                right_q++;
            } else {
                right_sum += (ch - '0');
            }
        }
        
        // Bob wins if (right_sum - left_sum) * 2 == (left_q - right_q) * 9
        // Alice wins otherwise (returns true)
        return (right_sum - left_sum) * 2 != (left_q - right_q) * 9;
    }
};
