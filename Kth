#include<queue>
class Solution {
public:
    int findKthLargest(vector<int>& nums, int k) {
        priority_queue<int>dq;
        for(int i = 0; i < nums.size(); i++){
            dq.push(nums[i]);
        }
        int i = 1;
        while( i < k){
            dq.pop();
            i++;
        }
        return dq.top();
    }
};
